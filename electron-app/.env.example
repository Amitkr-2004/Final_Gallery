# Environment Configuration
NODE_ENV=development

# GCP Configuration (override in .env.local)
GCP_PROJECT_ID=your-gcp-project-id
GCP_BUCKET_NAME=your-image-bucket
GCP_SERVICE_ACCOUNT_PATH=/path/to/service-account-key.json

# Backend API (Django)
BACKEND_API_URL=http://localhost:8000/api
BACKEND_API_KEY=your-api-key-here

# Application Settings
LOG_LEVEL=info
MAX_DOWNLOAD_WORKERS=5
MAX_PROCESSING_WORKERS=3

# Development Settings (only for dev environment)
WEBPACK_DEV_SERVER_PORT=9000
ELECTRON_RELOAD=true
