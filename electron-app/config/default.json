{
  "app": {
    "name": "Orchids Gallery",
    "version": "1.2.1",
    "environment": "development"
  },
  "backend": {
    "apiUrl": "http://127.0.0.1:8000",
    "timeout": 30000
  },
  "storage": {
    "appDataPath": "./app-data",
    "uploadPath": "./app-data/uploads",
    "originalsPath": "./app-data/uploads/originals",
    "compressedPath": "./app-data/uploads/compressed",
    "thumbnailsPath": "./app-data/uploads/thumbnails",
    "databasePath": "./app-data/database",
    "logsPath": "./app-data/logs"
  },
  "compression": {
    "compressed": {
      "maxWidth": 1920,
      "maxHeight": 1080,
      "quality": 80,
      "format": "jpeg"
    },
    "thumbnail": {
      "width": 300,
      "height": 300,
      "quality": 70,
      "format": "jpeg"
    }
  },
  "ui": {
    "windowWidth": 1200,
    "windowHeight": 800,
    "minWidth": 800,
    "minHeight": 600
  },
  "logging": {
    "level": "info",
    "maxFileSizeMB": 10,
    "maxFiles": 5
  }
}
